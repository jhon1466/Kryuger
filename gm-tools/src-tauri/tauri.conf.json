{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kryuger GM Tools",
  "version": "1.0.0",
  "identifier": "com.kryuger.gmtools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4321",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kryuger GM Tools",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}